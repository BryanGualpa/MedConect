# MedConnect Backend — Variables de entorno
# Copiar este archivo como .env y completar con los valores reales
# NUNCA subir el archivo .env al repositorio Git (SRS v1.0 sección 8.1)

# ─── BASE DE DATOS ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medconnect_user:tu_password@localhost:5432/medconnect_db

# ─── SERVIDOR ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT (mínimo 32 caracteres) ───────────────────────────────────────────────
JWT_SECRET=cambia-esto-por-una-clave-segura-de-minimo-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORREO SMTP (Nodemailer) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-gmail

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
